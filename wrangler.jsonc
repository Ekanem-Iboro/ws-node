{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the deployed Worker name, otherwise `wrangler deploy` publishes a
  // second Worker (and BASE_URL in shared/config.js goes stale).
  "name": "ws-node",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-29",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "THERMAL_ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
