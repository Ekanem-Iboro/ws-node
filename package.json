{
  "name": "thermal-relay",
  "version": "1.0.0",
  "private": true,
  "description": "WebSocket + HTTP relay between an ESP32-S3 thermal sensor and a web frontend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "express": "^5.1.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "wrangler": "^4.60.0"
  }
}
